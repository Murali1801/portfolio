---
import { site, repoUrl } from '../../site.config';

const github = `https://github.com/${site.github.user}`;
---

<footer class="site-footer">
  <div class="container">
    <div class="grid foot">
      <p class="sig mono">
        <span class="mark" aria-hidden="true"></span>
        <span>{site.shortName} · github.com/{site.github.user}</span>
      </p>
      <ul class="links mono">
        <li><a class="link" href={github} rel="me">GitHub <span class="arrow-ne" aria-hidden="true">↗</span></a></li>
        {site.email && <li>
          <a class="link" href={`mailto:${site.email}`} data-copy-email={site.email}>
            <span data-copy-label>Copy email</span>
          </a>
          <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
        </li>}
        <li><a class="link" href={repoUrl(site.github.repo)}>Source <span class="arrow-ne" aria-hidden="true">↗</span></a></li>
        <li>
          <button class="link spec-btn" type="button" aria-pressed="false" data-spec-toggle>
            Spec mode <kbd>G</kbd>
          </button>
        </li>
      </ul>
      <p class="colophon muted">Set in Schibsted Grotesk and JetBrains Mono. Built with Astro.</p>
    </div>
  </div>
</footer>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-copy-email]').forEach((a) => {
    const label = a.querySelector<HTMLElement>('[data-copy-label]');
    const status = a.parentElement?.querySelector<HTMLElement>('[data-copy-status]');
    let timer = 0;
    a.addEventListener('click', async (e) => {
      const email = a.dataset.copyEmail;
      if (!email || !navigator.clipboard) return; // falls back to mailto
      e.preventDefault();
      try {
        await navigator.clipboard.writeText(email);
        if (label) label.textContent = 'Copied';
        if (status) status.textContent = `${email} copied to clipboard`;
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          if (label) label.textContent = 'Copy email';
          if (status) status.textContent = '';
        }, 1600);
      } catch {
        window.location.href = a.href;
      }
    });
  });
</script>

<style>
  .site-footer {
    margin-top: 96px;
    border-top: 1px solid var(--fg);
    padding-block: 24px 40px;
  }

  .foot {
    row-gap: 8px;
    align-items: center;
  }

  .sig {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    text-transform: none;
    letter-spacing: 0.02em;
    font-size: 0.8125rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    column-gap: 20px;
  }

  .spec-btn {
    border: 0;
    background: none;
    padding: 0;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
    gap: 8px;
  }

  .spec-btn[aria-pressed='true'] {
    color: var(--accent);
  }

  .spec-btn[aria-pressed='true'] kbd {
    border-color: currentColor;
  }

  .colophon {
    font-size: var(--text-small);
  }

  @media (min-width: 1024px) {
    .sig {
      grid-column: 1 / span 4;
    }

    .links {
      grid-column: 5 / span 8;
      justify-content: flex-end;
    }

    .colophon {
      grid-column: 1 / span 8;
    }
  }
</style>
